# 站点鉴权的部署默认值，默认关闭；开启时用户名和密码均不能为空。
# WebUI「设置 → 站点鉴权」保存后立即生效、重启保留，优先于这些环境变量。
# 尚未保存 WebUI 配置时，修改环境变量需重启（Docker 需重建容器）。
# 浏览器使用内置登录框，API 使用 HTTP Basic；公网访问必须配合 HTTPS。
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=

# 哔咔账号仅用于 Token 不存在或失效时自动重新登录。
BIKA_ACCOUNT=
BIKA_PASSWORD=
# 可选：拷贝漫画 API 镜像地址（包含 /api/v3）
COPY_API_BASE=https://api.copy3000.com/api/v3
# 可选：JM 同步允许写入的服务器根目录；多个目录在 Linux/macOS 用 :，Windows 用 ; 分隔。
# 留空使用 DATA_DIR/jm-favorites；Docker 自定义路径需同时配置对应卷挂载。
JM_DOWNLOAD_ROOTS=
